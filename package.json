{
  "name": "seo-local-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:lesson": "node --experimental-strip-types scripts/generate-lesson.ts",
    "lint": "eslint .",
    "media": "tsc -p tsconfig.media.json && node .media-build/scripts/media/cli.js",
    "media:status": "npm run media -- status",
    "media:validate": "npm run media -- validate",
    "media:narration": "npm run media -- narration generate",
    "media:timestamps": "npm run media -- alignment generate",
    "media:prepare": "npm run media -- prepare",
    "media:review": "npm run media -- review",
    "media:approve": "npm run media -- approve",
    "media:integrate": "npm run media -- integrate",
    "media:generate-all": "node scripts/media/generate-all.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
