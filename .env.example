# Variáveis usadas pelo pipeline de rascunho de lições (Node, CLI local,
# nunca roda no navegador). Ver docs/09-PADRAO-DE-LICOES.md.

# Chave criada no Google AI Studio. Nunca registre o valor real no Git.
GOOGLE_AI_STUDIO_API_KEY=

# Opcionais
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PIPER_BIN=piper

# Variáveis usadas pelo app React via Vite (prefixo VITE_ obrigatório para
# ficarem disponíveis no navegador através de import.meta.env). Ver
# src/lib/firebase.ts e docs/05-BANCO-DE-DADOS.md.
#
# Nenhum projeto Firebase real foi criado ainda — estes valores vêm do
# console do Firebase (Configurações do projeto > Seus apps > Config) depois
# que o projeto existir. Diferente da chave do Gemini acima, a config web do
# Firebase não é secreta por natureza (é pública por design; a proteção real
# vem de firestore.rules) — mesmo assim ela fica em variável de ambiente, não
# fixada no código, seguindo o padrão do projeto (docs/04-REGRAS.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
