{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": ".",
    "outDir": ".media-build",
    "skipLibCheck": true
  },
  "include": ["scripts/media/**/*.ts", "src/content/lessons/**/*.ts"]
}
